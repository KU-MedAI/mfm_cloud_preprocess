# 72코어 / 2 TB DRAM / 400 GB ramdisk 를 전제로 한 고성능 프로파일.
# 기본값은 공유 클러스터를 가정해 보수적이다(STAR 4스레드 등). 마감이 있는 단독 실행에서는
# 그대로 두면 코어가 논다. `source` 해서 쓴다.

# ── 정렬 ──
export STAGE04_ALIGN_THREADS=${STAGE04_ALIGN_THREADS:-32}   # minimap2 map-hifi
export STAGE04_SORT_THREADS=${STAGE04_SORT_THREADS:-12}
export STAGE04_SORT_MEM=${STAGE04_SORT_MEM:-8G}
export STAGE04_EXTRACT_THREADS=${STAGE04_EXTRACT_THREADS:-8}

# ── VCF / consensus — contig 단위 병렬이라 22까지 의미 있다 ──
export VCF_JOBS=${VCF_JOBS:-22}
export VCF_CHROM_JOBS=${VCF_CHROM_JOBS:-22}
export VCF_THREADS_PER_CHROM=${VCF_THREADS_PER_CHROM:-2}

# ── WGS 재정렬 / window / compact ──
export WGS_REALIGN_THREADS=${WGS_REALIGN_THREADS:-16}
export WGS_REALIGN_JOBS=${WGS_REALIGN_JOBS:-2}
export WGS_SORT_THREADS=${WGS_SORT_THREADS:-8}
export WGS_SORT_MEM=${WGS_SORT_MEM:-8G}
export WINDOW_JOBS=${WINDOW_JOBS:-8}
export COMPACT_JOBS=${COMPACT_JOBS:-16}

# ── RNA / STAR ──
export STAR_INDEX_THREADS=${STAR_INDEX_THREADS:-16}
export STAR_ALIGN_THREADS=${STAR_ALIGN_THREADS:-16}
export RNA_MARKDUP_HEAP_GB=${RNA_MARKDUP_HEAP_GB:-32}
export CLAIR3_OUTPUT_THREADS=${CLAIR3_OUTPUT_THREADS:-16}

# ── ramdisk ──
# STAR index 는 random access 가 심해 ramdisk 효과가 가장 크다(hap 당 ~26 GB).
# RNA_WORK_ON_SHM=1 이면 호출부가 work root 를 /dev/shm 으로 잡는다.
export RNA_WORK_ON_SHM=${RNA_WORK_ON_SHM:-1}
export SHM_ROOT=${SHM_ROOT:-/dev/shm/mfm_work}
